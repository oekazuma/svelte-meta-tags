{
  "name": "@svelte-meta-tags/monorepo",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "preview": "pnpm -r preview",
    "package": "pnpm -r package",
    "check": "pnpm -r check",
    "lint": "vp fmt --check . && vp lint . && eslint . && node scripts/validate-skills.mjs",
    "format": "vp fmt .",
    "test": "pnpm -r test",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "typescript-eslint": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
